# Vite exposes only VITE_*-prefixed vars to client code (import.meta.env.VITE_*).
# These are build-time — set them in CI as Docker build args (see Dockerfile).
# Copy to .env.local for development.

# Base URL of the backend API.
VITE_API_URL=http://localhost:8000

# Public canonical site URL.
VITE_SITE_URL=https://collateralai.tinyfleet.dev

# OpenAPI schema endpoint used by `pnpm gen:api` to generate src/lib/api/schema.d.ts.
VITE_API_SCHEMA_URL=http://localhost:8000/api/schema/
